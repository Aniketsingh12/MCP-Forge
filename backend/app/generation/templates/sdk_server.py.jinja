def _call(func_name: str, kwargs: dict[str, Any]) -> dict[str, Any]:
    """Invoke a library function and normalise the outcome.

    Success -> {"ok": True, "result": ...}
    Failure -> {"ok": False, "error": "...", "error_type": "..."}
    """
    func = getattr(_sdk, func_name, None)
    if func is None:
        return {
            "ok": False,
            "error": f"{{ sdk_module }} has no attribute '{func_name}'",
            "error_type": "AttributeError",
        }

    # Omitted optional arguments fall through to the library's own defaults.
    clean = {k: v for k, v in kwargs.items() if v is not None}
    try:
        result = func(**clean)
    except Exception as exc:  # library errors become tool errors, not crashes
        return {"ok": False, "error": str(exc), "error_type": type(exc).__name__}

    return {"ok": True, "result": _serialise(result)}


def _serialise(value: Any) -> Any:
    """Best-effort conversion of a library return value to JSON-safe data."""
    if value is None or isinstance(value, (bool, int, float, str)):
        return value
    if isinstance(value, (list, tuple, set)):
        return [_serialise(v) for v in value]
    if isinstance(value, dict):
        return {str(k): _serialise(v) for k, v in value.items()}
    try:
        json.dumps(value)
        return value
    except (TypeError, ValueError):
        return repr(value)


