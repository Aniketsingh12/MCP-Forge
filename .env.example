# ---------------------------------------------------------------------------
# MCP Forge configuration. Copy to `.env`. Every value is optional — the
# platform runs fully with none of them set (deterministic, no model needed).
# ---------------------------------------------------------------------------

# LLM provider for OPTIONAL tool-description polishing.
#   none              -> disabled (default). Generation stays deterministic.
#   ollama            -> local open-source models (llama3.1, qwen2.5, ...)
#   openai-compatible -> OpenRouter / Together / Groq / vLLM / LM Studio / ...
#   anthropic         -> Claude
LLM_PROVIDER=none

# Model id (provider-specific). Examples:
#   ollama:            llama3.1
#   openai-compatible: meta-llama/llama-3.1-8b-instruct
#   anthropic:         claude-opus-4-8
LLM_MODEL=

# Base URL for the LLM API. Examples:
#   ollama:            http://localhost:11434/v1
#   openai-compatible: https://openrouter.ai/api/v1
LLM_BASE_URL=

# API key for the LLM provider (leave blank for local Ollama).
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Playground safety
# ---------------------------------------------------------------------------
# The playground launches your generated server as a child process, which makes
# its own HTTP calls. The base URL is validated before launch:
# comma-separated host allowlist; empty = any PUBLIC host (internal/private/
# loopback addresses are always blocked).
# Example: api.stripe.com,api.github.com
PLAYGROUND_ALLOWLIST=

# Seconds before a playground tool call is abandoned.
PLAYGROUND_TIMEOUT=30

# Where SQLite + generated data live (containers default this to /data).
# MCPFORGE_DATA_DIR=./backend/data

# ---------------------------------------------------------------------------
# Python SDK introspection (second input mode)
# ---------------------------------------------------------------------------
# Wraps an installed Python library's functions as tools, for software with no
# REST API. Introspection IMPORTS the module, which runs its top-level code —
# on a shared or hosted deployment that is remote code execution. Off unless
# you explicitly turn it on.
ENABLE_SDK_INTROSPECTION=false

# Optional comma-separated allowlist of importable root packages. Empty means
# any installed module may be introspected, which is only sensible for local,
# single-user use.
# Example: playwright,pandas
SDK_ALLOWED_MODULES=
